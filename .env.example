# Go backend: export manually. Never put real secrets in version control.
LISTEN_ADDR=127.0.0.1:8080
STATE_PATH=./data/state.json
# Required for all backend routes, including reads. Never use NEXT_PUBLIC_ for tokens.
ROTATOR_API_TOKEN=replace-with-a-random-local-token
# frontend/.env.local
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
# No AWS or Cloudflare credentials are accepted by this mock-only MVP.
